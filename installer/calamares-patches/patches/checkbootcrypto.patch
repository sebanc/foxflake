--- /dev/null
+++ b/src/modules/partition/core/BootEncryptionCheck.cpp
@@ -0,0 +1,31 @@
+#include "BootEncryptionCheck.h"
+
+#include "core/PartitionCoreModule.h"
+#include "partition/FileSystem.h"
+
+#include <kpmcore/core/partition.h>
+
+namespace BootEncryptionCheck
+{
+
+bool
+isBootPartitionEncrypted( const PartitionCoreModule* core )
+{
+    if ( !core )
+    {
+        return false;
+    }
+    if ( Partition* boot_p = core->findPartitionByMountPoint( "/boot" ) )
+    {
+        const auto t = boot_p->fileSystem().type();
+        return t == FileSystem::Luks || t == FileSystem::Luks2;
+    }
+    if ( Partition* root_p = core->findPartitionByMountPoint( "/" ) )
+    {
+        const auto t = root_p->fileSystem().type();
+        return t == FileSystem::Luks || t == FileSystem::Luks2;
+    }
+    return false;
+}
+
+}  // namespace BootEncryptionCheck
